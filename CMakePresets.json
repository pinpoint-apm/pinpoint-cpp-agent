{
    "version": 3,
    "cmakeMinimumRequired": {
        "major": 3,
        "minor": 21,
        "patch": 0
    },
    "configurePresets": [
        {
            "name": "base",
            "hidden": true,
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build/${presetName}",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release",
                "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
            }
        },
        {
            "name": "default",
            "inherits": "base",
            "displayName": "System / PATH find_package",
            "description": "Resolve dependencies via CMAKE_PREFIX_PATH and system find_package; falls back to FetchContent."
        },
        {
            "name": "vcpkg",
            "inherits": "base",
            "displayName": "vcpkg toolchain",
            "description": "Resolve dependencies via vcpkg. Requires VCPKG_ROOT to be set in the environment.",
            "toolchainFile": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake"
        },
        {
            "name": "debug",
            "inherits": "default",
            "displayName": "Debug build (system)",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug"
            }
        },
        {
            "name": "debug-cached",
            "inherits": "debug",
            "displayName": "Debug build (shared FetchContent cache)",
            "description": "Debug build that reuses a shared FetchContent download/build cache across presets to avoid re-fetching dependencies.",
            "cacheVariables": {
                "FETCHCONTENT_BASE_DIR": "$env{HOME}/.cache/cmake-fetchcontent"
            }
        },
        {
            "name": "coverage",
            "inherits": "default",
            "displayName": "LLVM coverage (Clang)",
            "description": "Build tests with Clang source-based coverage instrumentation and generate llvm-cov reports.",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "CMAKE_C_COMPILER": "clang",
                "CMAKE_CXX_COMPILER": "clang++",
                "BUILD_COVERAGE": "ON",
                "BUILD_EXAMPLES": "OFF",
                "BUILD_SHARED_LIBS": "ON",
                "BUILD_STATIC_LIBS": "OFF"
            }
        },
        {
            "name": "profiling",
            "inherits": "default",
            "displayName": "Optimized sampling-profiler build",
            "description": "RelWithDebInfo build with frame pointers for macOS xctrace and Linux perf.",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "RelWithDebInfo",
                "BUILD_PROFILING": "ON",
                "BUILD_EXAMPLES": "OFF",
                "BUILD_SHARED_LIBS": "ON",
                "BUILD_STATIC_LIBS": "OFF"
            }
        },
        {
            "name": "asan",
            "inherits": "default",
            "displayName": "AddressSanitizer (ASan)",
            "description": "Debug build with -fsanitize=address to catch use-after-free, heap/stack overflow, and leaks. Resolves dependencies like the default preset.",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "SANITIZE": "address",
                "BUILD_EXAMPLES": "OFF",
                "BUILD_SHARED_LIBS": "ON",
                "BUILD_STATIC_LIBS": "OFF"
            }
        },
        {
            "name": "tsan",
            "inherits": "default",
            "displayName": "ThreadSanitizer (TSan)",
            "description": "Debug build with -fsanitize=thread to catch data races across the agent's worker threads, queues and caches.",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "SANITIZE": "thread",
                "BUILD_EXAMPLES": "OFF",
                "BUILD_SHARED_LIBS": "ON",
                "BUILD_STATIC_LIBS": "OFF"
            }
        },
        {
            "name": "ubsan",
            "inherits": "default",
            "displayName": "UndefinedBehaviorSanitizer (UBSan)",
            "description": "Debug build with -fsanitize=undefined (halts on first error) to catch UB such as out-of-range float-to-int casts and signed overflow.",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "SANITIZE": "undefined",
                "BUILD_EXAMPLES": "OFF",
                "BUILD_SHARED_LIBS": "ON",
                "BUILD_STATIC_LIBS": "OFF"
            }
        }
    ],
    "buildPresets": [
        {
            "name": "default",
            "configurePreset": "default"
        },
        {
            "name": "vcpkg",
            "configurePreset": "vcpkg"
        },
        {
            "name": "debug",
            "configurePreset": "debug"
        },
        {
            "name": "debug-cached",
            "configurePreset": "debug-cached"
        },
        {
            "name": "coverage",
            "configurePreset": "coverage",
            "targets": [
                "coverage"
            ]
        },
        {
            "name": "profiling",
            "configurePreset": "profiling",
            "targets": [
                "it_test_server",
                "http_downstream_server",
                "grpc_server",
                "c_api_scenario",
                "fork_scenario"
            ]
        },
        {
            "name": "asan",
            "configurePreset": "asan"
        },
        {
            "name": "tsan",
            "configurePreset": "tsan"
        },
        {
            "name": "ubsan",
            "configurePreset": "ubsan"
        }
    ],
    "testPresets": [
        {
            "name": "default",
            "configurePreset": "default",
            "output": {
                "outputOnFailure": true
            },
            "execution": {
                "stopOnFailure": false
            }
        },
        {
            "name": "vcpkg",
            "configurePreset": "vcpkg",
            "output": {
                "outputOnFailure": true
            },
            "execution": {
                "stopOnFailure": false
            }
        },
        {
            "name": "debug",
            "configurePreset": "debug",
            "output": {
                "outputOnFailure": true
            },
            "execution": {
                "stopOnFailure": false
            }
        },
        {
            "name": "debug-cached",
            "configurePreset": "debug-cached",
            "output": {
                "outputOnFailure": true
            },
            "execution": {
                "stopOnFailure": false
            }
        },
        {
            "name": "asan",
            "configurePreset": "asan",
            "output": {
                "outputOnFailure": true
            },
            "execution": {
                "stopOnFailure": false
            },
            "environment": {
                "ASAN_OPTIONS": "abort_on_error=1:suppressions=${sourceDir}/scripts/asan.supp"
            }
        },
        {
            "name": "tsan",
            "configurePreset": "tsan",
            "output": {
                "outputOnFailure": true
            },
            "execution": {
                "stopOnFailure": false
            },
            "environment": {
                "TSAN_OPTIONS": "halt_on_error=1:suppressions=${sourceDir}/scripts/tsan.supp"
            }
        },
        {
            "name": "ubsan",
            "configurePreset": "ubsan",
            "output": {
                "outputOnFailure": true
            },
            "execution": {
                "stopOnFailure": false
            },
            "environment": {
                "UBSAN_OPTIONS": "halt_on_error=1:print_stacktrace=1"
            }
        }
    ]
}
