module(
    name = "pinpoint-cpp",
    version = "2.0.0",
    compatibility_level = 1,
)

bazel_dep(name = "rules_proto", version = "7.1.0")
bazel_dep(name = "rules_cc", version = "0.1.1")
bazel_dep(name = "rules_shell", version = "0.2.0")
bazel_dep(name = "protobuf", version = "29.2", repo_name = "com_google_protobuf")
bazel_dep(name = "grpc", version = "1.63.1", repo_name = "com_github_grpc_grpc")
bazel_dep(name = "yaml-cpp", version = "0.8.0", repo_name = "com_github_jbeder_yaml_cpp")
bazel_dep(name = "abseil-cpp", version = "20250127.1", repo_name = "com_google_absl")
bazel_dep(name = "fmt", version = "11.1.4")
bazel_dep(name = "googletest", version = "1.17.0")

# cpp-httplib serves the examples and the e2e test servers; the agent library
# never includes it. Fetched directly rather than taken from the Bazel Central
# Registry: the BCR module declares boringssl and zlib, and pulling those into
# the module graph raises the version MVS resolves for abseil-cpp above what the
# protobuf pinned above accepts, which breaks analysis of every target. A bare
# header target has no such effect, and matches the version vcpkg.json resolves.
http_archive = use_repo_rule("@bazel_tools//tools/build_defs/repo:http.bzl", "http_archive")

http_archive(
    name = "cpp_httplib",
    build_file_content = """
cc_library(
    name = "httplib",
    hdrs = ["httplib.h"],
    includes = ["."],
    visibility = ["//visibility:public"],
)
""",
    sha256 = "67bd39bf975dfa16c964c0328744a545d8fb3d3856c9a3ee1b4c2ee4350aee0f",
    strip_prefix = "cpp-httplib-0.49.0",
    urls = ["https://github.com/yhirose/cpp-httplib/archive/refs/tags/v0.49.0.tar.gz"],
)
