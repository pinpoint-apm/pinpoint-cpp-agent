# nginx addon build script for the Pinpoint C++ agent example module.
#
# Build as a dynamic module (recommended):
#   ./configure --add-dynamic-module=/path/to/pinpoint-cpp-agent/example/nginx \
#               --with-cc-opt="-I/path/to/pinpoint-cpp-agent/include" \
#               --with-ld-opt="-L/path/to/pinpoint-cpp-agent/lib -lpinpoint_cpp"
#
# See README.md in this directory for details.

ngx_addon_name=ngx_http_pinpoint_module

if test -n "$ngx_module_link"; then
    ngx_module_type=HTTP
    ngx_module_name=ngx_http_pinpoint_module
    ngx_module_srcs="$ngx_addon_dir/ngx_http_pinpoint_module.c"
    ngx_module_libs="-lpinpoint_cpp"

    . auto/module
else
    HTTP_MODULES="$HTTP_MODULES ngx_http_pinpoint_module"
    NGX_ADDON_SRCS="$NGX_ADDON_SRCS $ngx_addon_dir/ngx_http_pinpoint_module.c"
    CORE_LIBS="$CORE_LIBS -lpinpoint_cpp"
fi
