package(default_visibility = ["//visibility:public"])

licenses(["notice"])  # Apache 2

genrule(
    name = "generate_version_h",
    srcs = ["MODULE.bazel"],
    outs = ["version.h"],
    cmd = """
        VERSION=$$(grep 'version = ' $(location MODULE.bazel) | head -1 | sed 's/.*version = "\\(.*\\)".*/\\1/')
        cat > $@ <<EOF
#pragma once

#define VERSION_STRING  "$$VERSION"
EOF
    """,
)

cc_library(
    name = "version",
    hdrs = [":generate_version_h"],
)

# The src/ headers ride in :pinpoint-cpp's srcs, which does not expose them to
# dependents — they are implementation detail, not API. The benchmarks measure
# those internals directly (the CMake side reaches them with
# target_include_directories(... ../src)), so re-export them to that package
# alone rather than widening the library's own header surface.
#
# Deliberately depends on nothing: the header-only benchmarks compile the
# measured code into their own translation unit, and pulling :pinpoint-cpp in
# here would make all of them link the library and gRPC behind it, which the
# CMake targets do not. The two benchmarks that really need the library ask
# for it themselves.
cc_library(
    name = "internal_headers",
    hdrs = glob(["src/*.h"]) + [
        "include/pinpoint/tracer.h",
        "include/pinpoint/tracer_c.h",
    ],
    includes = [
        "include",
        "src",
    ],
    visibility = ["//benchmark:__pkg__"],
)

cc_library(
    name = "pinpoint-cpp",
    srcs = glob(["src/*.cpp", "src/*.h"]),
    hdrs = [
        "include/pinpoint/tracer.h",
        "include/pinpoint/tracer_c.h",
    ],
    includes = [
        "3rd_party",
        "include",
    ],
    strip_include_prefix = "include/",
    visibility = ["//visibility:public"],
    deps = [
        ":version",
        "//3rd_party:annotation_grpc_cc",
        "//3rd_party:cmd_grpc_cc",
        "//3rd_party:murmur_hash3",
        "//3rd_party:service_grpc_cc",
        "//3rd_party:span_grpc_cc",
        "//3rd_party:stat_grpc_cc",
        "//3rd_party:thread_dump_grpc_cc",
        "@com_github_grpc_grpc//:grpc++",
        "@com_github_jbeder_yaml_cpp//:yaml-cpp",
        "@com_google_absl//absl/strings",
        "@fmt",
    ],
)
